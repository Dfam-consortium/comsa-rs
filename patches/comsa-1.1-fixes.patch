 // *******************************************************************************************
+// Symbols allowed in aligned sequences: gaps ('-', '.'), letters, stop ('*'), missing data ('~').
+// Other symbols would get second-stage ranks that collide with RLE-0 codes (125, 126)
+// or exceed the range of the entropy coder's selector model, so they are rejected on input.
+inline bool is_valid_seq_symbol(uint8_t c)
+{
+	return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || c == '-' || c == '.' || c == '*' || c == '~';
+}
+
+// *******************************************************************************************
+// Printable description of a symbol for error messages
+inline string describe_symbol(uint8_t c)
+{
+	char buf[16];
+	if (c >= 33 && c < 127)
+		snprintf(buf, sizeof(buf), "'%c'", c);
+	else
+		snprintf(buf, sizeof(buf), "0x%02X", c);
+	return string(buf);
+}
+
+// *******************************************************************************************
+// Check that all sequences consist of valid symbols and are of the same length.
+// On failure, returns false and describes the problem in err.
+inline bool validate_sequences(const vector<string> &v_names, const vector<string> &v_sequences, string &err)
+{
+	if (v_sequences.empty())
+		return true;
+
+	size_t len = v_sequences.front().size();
+
+	for (size_t i = 0; i < v_sequences.size(); ++i)
+	{
+		auto &seq = v_sequences[i];
+		string name = i < v_names.size() ? v_names[i] : string();
+		while (!name.empty() && (name.back() == ' ' || name.back() == '\t'))
+			name.pop_back();
+
+		for (size_t j = 0; j < seq.size(); ++j)
+			if (!is_valid_seq_symbol((uint8_t)seq[j]))
+			{
+				err = "invalid symbol " + describe_symbol((uint8_t)seq[j]) + " in sequence " + name + " at column " + to_string(j + 1) +
+					" (allowed: A-Z, a-z, '-', '.', '*', '~')";
+				return false;
+			}
+
+		if (seq.size() != len)
+		{
+			err = "sequence " + name + " has length " + to_string(seq.size()) + " but the first sequence has length " + to_string(len) +
+				" (interleaved/multi-block Stockholm is not supported)";
+			return false;
+		}
+	}
+
+	return true;
+}
