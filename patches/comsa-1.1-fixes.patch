+// *******************************************************************************************
+// Initial order of symbols in the second-stage (WFC/MTF) lists.
+// '~' was added after '*'; it does not change the ranks of the other valid symbols.
+inline const std::vector<int> &legal_symbol_order()
+{
+	static const std::vector<int> v_legal_symbols = [] {
+		std::vector<int> v;
+
+		v.push_back('-');
+		v.push_back('.');
+		for (int c = 'A'; c <= 'Z'; ++c)
+			v.push_back(c);
+		for (int c = 'a'; c <= 'z'; ++c)
+			v.push_back(c);
+		v.push_back('*');
+		v.push_back('~');
+
+		for (int i = 0; i < 128; ++i)
+			if (std::count(v.begin(), v.end(), i) == 0)
+				v.push_back(i);
+
+		return v;
+	}();
+
+	return v_legal_symbols;
+}
