+// *******************************************************************************************
+// Process items in parallel keeping their order:
+//    * read(item, cost) is called in the calling thread; returns 1 (item read), 0 (no more items) or -1 (error);
+//      cost is an estimate of memory needed for the item
+//    * process(msac, in, out) is called in n_workers threads, each having its own compressor object
+//    * write(out) is called (in a separate thread) in the order in which items were read
+// Returns false if any of the callbacks failed.
+template<typename T_IN, typename T_OUT> bool process_in_order(int n_workers,
+	function<int(T_IN &, size_t &)> read, function<bool(CMSACompress &, T_IN &, T_OUT &)> process, function<bool(T_OUT &)> write)
+{
+	mutex mtx;
+	condition_variable cv;
+
+	deque<pair<size_t, T_IN>> q_in;
+	map<size_t, T_OUT> m_out;
+	map<size_t, size_t> m_cost;
+	size_t n_read = 0;
+	size_t n_written = 0;
+	size_t in_flight_bytes = 0;
+	bool reading_done = false;
+	bool failed = false;
+	const size_t max_in_flight = 2 * n_workers + 2;
+
+	vector<thread> v_workers;
+	for (int i = 0; i < n_workers; ++i)
+		v_workers.emplace_back([&] {
+			auto msac = make_msac(n_workers > 1);
+
+			while (true)
+			{
+				unique_lock<mutex> lck(mtx);
+				cv.wait(lck, [&] { return !q_in.empty() || reading_done || failed; });
+
+				if (failed || q_in.empty())
+					return;
+
+				auto item = move(q_in.front());
+				q_in.pop_front();
+				lck.unlock();
+
+				T_OUT out;
+				bool ok = process(*msac, item.second, out);
+
+				lck.lock();
+				if (ok)
+					m_out.emplace(item.first, move(out));
+				else
+					failed = true;
+				cv.notify_all();
+			}
+		});
+
+	thread writer([&] {
+		while (true)
+		{
+			unique_lock<mutex> lck(mtx);
+			cv.wait(lck, [&] { return failed || m_out.count(n_written) || (reading_done && n_written == n_read); });
+
+			if (failed || !m_out.count(n_written))
+				return;
+
+			T_OUT out = move(m_out[n_written]);
+			m_out.erase(n_written);
+			lck.unlock();
+
+			bool ok = write(out);
+
+			lck.lock();
+			if (!ok)
+				failed = true;
+			in_flight_bytes -= m_cost[n_written];
+			m_cost.erase(n_written);
+			++n_written;
+			cv.notify_all();
+		}
+	});
+
+	// Reading in the calling thread
+	while (true)
+	{
+		{
+			unique_lock<mutex> lck(mtx);
+			cv.wait(lck, [&] { return failed ||
+				(n_read - n_written < max_in_flight && (in_flight_bytes < MAX_IN_FLIGHT_BYTES || n_read == n_written)); });
+			if (failed)
+				break;
+		}
+
+		T_IN item;
+		size_t cost = 0;
+		int r = read(item, cost);
+
+		lock_guard<mutex> lck(mtx);
+		if (r <= 0)
+		{
+			if (r < 0)
+				failed = true;
+			break;
+		}
+
+		q_in.emplace_back(n_read, move(item));
+		m_cost[n_read] = cost;
+		in_flight_bytes += cost;
+		++n_read;
+		cv.notify_all();
+	}
+
+	{
+		lock_guard<mutex> lck(mtx);
+		reading_done = true;
+		cv.notify_all();
+	}
+
+	for (auto &t : v_workers)
+		t.join();
+	writer.join();
+
+	return !failed;
+}
